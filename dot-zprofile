# Add Homebrew to PATH if it's installed
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Restore mise precedence after system login and Homebrew PATH setup.
export PATH="$HOME/.local/bin:${MISE_DATA_DIR:-$XDG_DATA_HOME/mise}/shims:$HOME/bin:$HOME/.local/share/npm:$HOME/.cargo/bin:${GOPATH:+$GOPATH/bin:}/Applications/MATLAB_R2025b.app/bin:/usr/bin:$PATH"
export EDITOR='nvim'
export MANPAGER="nvim +Man!"
