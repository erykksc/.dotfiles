#!/usr/bin/env bash

# Gracefully close every tab in the OS window containing the pane that
# invoked this script.
#
# kitty's close-window/close-os-window actions close the terminal, but they do
# not guarantee that a child which has ignored SIGHUP has stopped.  We first
# interrupt foreground jobs, then terminate any remaining descendants of the
# pane shells, and only close kitty after the tracked processes are gone.

set -uo pipefail

fail() {
  printf 'kitty-graceful-close: %s\n' "$1" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send 'Kitty: could not close tabs' "$1" 2>/dev/null || true
  elif command -v osascript >/dev/null 2>&1; then
    osascript - "$1" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  display alert "Kitty: could not close tabs" message (item 1 of argv)
end run
APPLESCRIPT
  fi
  exit 1
}

if ! command -v kitty >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  fail 'This script requires kitty and jq on PATH.'
fi

# Background launches do not set KITTY_WINDOW_ID. The keybind passes Kitty's
# @active-kitty-window-id placeholder; retain the environment fallback for
# running the helper directly from a terminal.
source_window_id="${1:-${KITTY_WINDOW_ID:-}}"
case "$source_window_id" in
  ''|*[!0-9]*) fail 'No valid source pane ID. Reload kitty.conf to apply the updated shortcut.' ;;
esac

kitty_rc() {
  # Kitty supplies KITTY_LISTEN_ON=fd:... for --allow-remote-control background
  # launches. Let its client use that connection (or the terminal for manual use).
  kitty @ "$@"
}

# This script is launched as a background process.  Prevent a second press of
# the shortcut from starting another shutdown sequence for the same window.
lock_dir="${TMPDIR:-/tmp}/kitty-graceful-close-${source_window_id}.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

listing="$(kitty_rc ls)" || fail 'Could not contact Kitty through its remote-control connection.'

os_window_id="$(printf '%s\n' "$listing" | jq -r --arg id "$source_window_id" '
  .[]
  | select(any(.tabs[]?.windows[]?; (.id | tostring) == $id))
  | .id
' | head -n 1)"

[ -n "$os_window_id" ] && [ "$os_window_id" != "null" ] || fail 'The invoking pane was not found in this Kitty instance.'

# Save kitty-window-id/pane-shell-pid pairs before sending any signals.
windows_file="${TMPDIR:-/tmp}/kitty-graceful-close-windows-$$"
tabs_file="${TMPDIR:-/tmp}/kitty-graceful-close-tabs-$$"
trap 'rm -f "$windows_file" "$tabs_file"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
printf '%s\n' "$listing" | jq -r --arg os "$os_window_id" '
  .[]
  | select((.id | tostring) == $os)
  | .tabs[]?.windows[]?
  | [.id, .pid]
  | @tsv
' >"$windows_file"

# Keep the tab IDs from the same snapshot. Closing each tab explicitly lets
# Kitty run its normal tab-close behavior while limiting the action to this
# OS window, even if focus changes during the shutdown sequence.
printf '%s\n' "$listing" | jq -r --arg os "$os_window_id" '
  .[]
  | select((.id | tostring) == $os)
  | .tabs[]?.id
' >"$tabs_file"

pane_count="$(wc -l <"$windows_file" | tr -d ' ')"
[ "${pane_count:-0}" -gt 0 ] || exit 1

# Ask before touching interactive applications.  This is intentionally a
# native macOS dialog because this configuration is macOS-specific.
if command -v osascript >/dev/null 2>&1; then
  osascript \
    -e "display dialog \"Gracefully stop processes in $pane_count kitty pane(s) and close this kitty window?\" buttons {\"Cancel\", \"Continue\"} default button \"Cancel\" with title \"Close kitty window\"" \
    >/dev/null 2>&1 || exit 0
fi

root_pids="$(awk '{print $2}' "$windows_file" | sort -u | tr '\n' ' ')"
tracked_file="${TMPDIR:-/tmp}/kitty-graceful-close-tracked-$$"
: >"$tracked_file"
trap 'rm -f "$windows_file" "$tabs_file" "$tracked_file"; rmdir "$lock_dir" 2>/dev/null || true' EXIT

is_root_pid() {
  case " $root_pids " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Do not track this helper or commands it starts (jq, ps, sleep, etc.) if the
# background launcher happens to place the helper below a pane shell.
is_own_tree_pid() {
  [ "$1" -eq "$$" ] && return 0
  ps -axo pid=,ppid= 2>/dev/null | awk -v target="$1" -v self="$$" '
    { parent[$1] = $2 }
    END {
      current = target
      while (current != "" && current != 1) {
        if (current == self) exit 0
        current = parent[current]
      }
      exit 1
    }
  '
}

# Add a PID together with its start time.  The start time prevents a reused
# PID from being signalled after the original process has exited.
track_pid() {
  pid="$1"
  [ -n "$pid" ] || return 0
  case "$pid" in
    *[!0-9]*) return 0 ;;
  esac
  # The background launcher should not normally be a child of a pane shell,
  # but excluding this process also makes the tracking safe if it is.
  is_own_tree_pid "$pid" && return 0
  is_root_pid "$pid" && return 0

  start="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//; s/[[:space:]]*$//')"
  [ -n "$start" ] || return 0
  awk -F '\t' -v pid="$pid" '$1 == pid { found=1 } END { exit found ? 0 : 1 }' "$tracked_file" && return 0
  printf '%s\t%s\n' "$pid" "$start" >>"$tracked_file"
}

# Return all descendants of the pane shells from a single process snapshot.
descendants() {
  ps -axo pid=,ppid= 2>/dev/null | awk -v roots="$root_pids" '
    BEGIN {
      root_count = split(roots, root_values, /[[:space:]]+/)
      for (i = 1; i <= root_count; i++) if (root_values[i] != "") {
        seen[root_values[i]] = 1
        root[root_values[i]] = 1
      }
    }
    {
      pid[++count] = $1
      parent[$1] = $2
    }
    END {
      do {
        changed = 0
        for (i = 1; i <= count; i++) {
          child = pid[i]
          if (!seen[child] && seen[parent[child]]) {
            seen[child] = 1
            changed = 1
          }
        }
      } while (changed)
      for (i = 1; i <= count; i++)
        if (seen[pid[i]] && !root[pid[i]]) print pid[i]
    }
  '
}

refresh_tracked() {
  for pid in $(descendants); do
    track_pid "$pid"
  done
}

# Also record kitty's view of foreground processes.  Normally they are already
# descendants, but this covers a process during a short parent-transition.
while IFS= read -r pid; do
  track_pid "$pid"
done < <(printf '%s\n' "$listing" | jq -r --arg os "$os_window_id" '
  .[]
  | select((.id | tostring) == $os)
  | .tabs[]?.windows[]?.foreground_processes[]?.pid
')
refresh_tracked

live_records() {
  while IFS=$'\t' read -r pid start; do
    [ -n "${pid:-}" ] || continue
    current_start="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//; s/[[:space:]]*$//')"
    [ "$current_start" = "$start" ] || continue
    stat="$(ps -p "$pid" -o stat= 2>/dev/null | tr -d '[:space:]')"
    case "$stat" in
      ""|Z*) continue ;;
    esac
    printf '%s\t%s\n' "$pid" "$start"
  done <"$tracked_file"
}

signal_live() {
  signal="$1"
  while IFS=$'\t' read -r pid start; do
    [ -n "${pid:-}" ] || continue
    current_start="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//; s/[[:space:]]*$//')"
    [ "$current_start" = "$start" ] || continue
    kill "-$signal" "$pid" 2>/dev/null || true
  done < <(live_records)
}

wait_for_exit() {
  seconds="$1"
  while [ "$seconds" -gt 0 ]; do
    refresh_tracked
    if [ -z "$(live_records)" ]; then
      return 0
    fi
    sleep 1
    seconds=$((seconds - 1))
  done
  refresh_tracked
  [ -z "$(live_records)" ]
}

# SIGINT is equivalent to Ctrl-C for the foreground job and gives dev servers
# and interactive programs their normal cleanup path.
while IFS=$'\t' read -r window_id _; do
  kitty_rc signal-child --match "id:$window_id" SIGINT >/dev/null 2>&1 || true
done <"$windows_file"

# Give normal Ctrl-C handlers time to clean up.  Then ask background children
# to terminate gracefully.
wait_for_exit 5 || true
refresh_tracked
signal_live TERM

if ! wait_for_exit 5; then
  remaining="$(live_records | cut -f1 | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
  if command -v osascript >/dev/null 2>&1; then
    if ! osascript \
      -e "display dialog \"Some processes did not exit after SIGINT and SIGTERM.\n\nPIDs: $remaining\n\nForce-kill them?\" buttons {\"Leave open\", \"Force close\"} default button \"Leave open\" cancel button \"Leave open\" with title \"Processes still running\"" \
      >/dev/null 2>&1; then
      exit 0
    fi
  else
    fail "Some processes are still running (PIDs: $remaining). Tabs were left open."
  fi

  # Force-kill is only used after an explicit choice in the dialog.
  refresh_tracked
  signal_live KILL
  wait_for_exit 2 || exit 1
fi

# Close only the tabs captured from the invoking pane's OS window. Using tab
# IDs avoids accidentally closing tabs in another window if focus changed.
while IFS= read -r tab_id; do
  [ -n "$tab_id" ] || continue
  kitty_rc close-tab --match "id:$tab_id" --ignore-no-match >/dev/null || fail "Could not close tab $tab_id."
done <"$tabs_file"
