#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/context.bash"
case ${1:-} in
    left) key=alt+h ;;
    down) key=alt+j ;;
    up) key=alt+k ;;
    right) key=alt+l ;;
    *) fail 'usage: herdr-navigate left|down|up|right' ;;
esac
forward() {
    herdr_cli pane send-keys "$source_pane" "$key" >/dev/null || fail "cannot forward $key to $source_pane"
}
# A failed/empty inspection must not steal the chord from the application.
if ! info=$(herdr_cli pane process-info --pane "$source_pane"); then
    printf 'herdr shortcut: process inspection failed; forwarding %s\n' "$key" >&2
    forward
    exit
fi
if ! jq -e '.result.process_info.foreground_processes | type == "array" and length > 0' <<<"$info" >/dev/null; then
    forward
elif jq -e 'any(.result.process_info.foreground_processes[];
    ([.name, .argv0, .argv[0]] | any(. != null and (split("/") | last) == "nvim")))' <<<"$info" >/dev/null; then
    forward
else
    if ! neighbor=$(herdr_cli pane neighbor --pane "$source_pane" --direction "$1"); then
        printf 'herdr shortcut: neighbor lookup failed; forwarding %s\n' "$key" >&2
        forward
    elif jq -e '.result.neighbor.neighbor_pane_id | type == "string" and length > 0' <<<"$neighbor" >/dev/null; then
        herdr_cli pane focus --pane "$source_pane" --direction "$1" >/dev/null || fail "cannot focus $1 of $source_pane"
    else
        forward
    fi
fi
